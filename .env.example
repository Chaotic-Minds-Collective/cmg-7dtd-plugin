# 7 Days to Die Adapter Configuration
# Copy this file to .env and fill in your secure production values. Never commit real secrets.

CORE_API_BASE_URL=https://core.example.com
CORE_API_SERVICE_TOKEN=your_service_token_here
CORE_SERVER_ID=your_server_uuid_here
GAME_SERVER_VERSION=1.0
ADAPTER_VERSION=0.1.0

# Optional local Telnet health-check helper; keep interface private.
TELNET_HOST=127.0.0.1
TELNET_PORT=8081
TELNET_PASSWORD=your_telnet_password_here
HEARTBEAT_INTERVAL_MS=120000

# Primary Web API/SSE bridge.
SDTD_API_URL=https://127.0.0.1:8080/
SDTD_API_TOKEN_NAME=
SDTD_API_TOKEN_SECRET=
SDTD_SSE_ENDPOINT=
SDTD_ALLOW_INSECURE_HTTP=false

# Event Mapping and Cursors
SDTD_EVENT_MAP={}
CORE_EVENT_SPOOL_PATH=./data/core-events.jsonl
SDTD_EVENT_CURSOR_PATH=./data/last-event-id.txt
